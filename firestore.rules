rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: only admin or teacher can create/update/delete students (least-privilege)
    function isAdminOrTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'];
    }

    function getSubject(subjectId) {
      return get(/databases/$(database)/documents/subjects/$(subjectId));
    }
    function isSubjectTeacher(subjectId) {
      let s = getSubject(subjectId).data;
      return request.auth != null
        && (s.subjectTeacherUid == request.auth.uid
            || s.subjectTeacherId == request.auth.uid
            || s.teacherId == request.auth.uid);
    }

    // Role from users/{uid} (for push-token reads by teachers sending notifications).
    function userRole(uid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    function isTeacherOrAdminUid(uid) {
      let r = userRole(uid);
      return r == 'teacher' || r == 'admin';
    }

    // Users: own doc only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Students: read by any authenticated user. Create/delete only by admin or teacher.
    // Update: admin/teacher can update any; any authenticated user can "claim" a doc when it has no uid (field missing or null) and they set uid to their own.
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdminOrTeacher();
      allow update: if isAdminOrTeacher()
        || (
          request.auth != null
          && (!('uid' in resource.data) || resource.data.uid == null)
          && request.resource.data.uid == request.auth.uid
        );
    }

    // Teachers: read by any authenticated user. Create/delete only by admin or teacher.
    // Update: admin/teacher can update any; any authenticated user can "claim" a doc when it has no uid (field missing or null) and they set uid to their own.
    match /teachers/{teacherId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdminOrTeacher();
      allow update: if isAdminOrTeacher()
        || (
          request.auth != null
          && (!('uid' in resource.data) || resource.data.uid == null)
          && request.resource.data.uid == request.auth.uid
        );
    }

    // Classes: one incharge per class enforced in app; rules allow authenticated write
    match /classes/{classId} {
      allow read, write: if request.auth != null;
    }

    // Attendance: editable only before 5 PM on the same day (enforced in app; rules allow authenticated write)
    match /attendance/{id} {
      allow read, write: if request.auth != null;
    }

    // Owner may write; owner or teacher/admin may read (teachers need student tokens to send Expo pushes).
    match /userPushTokens/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isTeacherOrAdminUid(request.auth.uid));
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /admins/{id} {
      allow read, write: if request.auth != null;
    }
    match /sessions/{id} {
      allow read, write: if request.auth != null;
    }

    // Server / Admin SDK only (session reset lock, audit trail, archives)
    match /system/{document=**} {
      allow read, write: if false;
    }
    match /auditLogs/{id} {
      allow read, write: if false;
    }
    match /sessionArchives/{id} {
      allow read, write: if false;
    }

    // Subjects: read/write for authenticated; edit subject name/teacher in app
    match /subjects/{subjectId} {
      allow read, write: if request.auth != null;
      match /assignments/{assignmentId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && isSubjectTeacher(subjectId);
        // Any authenticated user may read submissions (app filters by student id / uid).
        // Writes remain restricted to the subject teacher.
        match /submissions/{submissionId} {
          allow read: if request.auth != null;
          allow create, update, delete: if request.auth != null && isSubjectTeacher(subjectId);
        }
      }
    }
  }
}
